# Production build targets — point the frontend directly at Cloud Run.
# Firebase Hosting has no /api/** rewrite, so relative paths 404 to index.html.
# SSE is served cross-origin (CORS allows nasa-comp-demo.web.app).
VITE_API_URL=https://spatialhub-backend-4vovlomqfa-uc.a.run.app/api
VITE_SURVIVAL_API=https://spatialhub-backend-4vovlomqfa-uc.a.run.app/api/survival
