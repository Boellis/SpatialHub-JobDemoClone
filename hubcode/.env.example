# SpatialHub Pi Hub Client -- environment template
# Copy to .env and fill in your values before running hub_client.py

# Hub identity (must match what you registered via /api/provision/)
HUB_ID=pi-habitat-01

# Sensor identity
SENSOR_ID=wr-ph-real

# Must match frontend SENSOR_MAP key -- use lowercase ph, not pH Sensor
SENSOR_NAME=ph

# Atlas EZO I2C address in decimal (0x63 = 99 for pH EZO)
DEVICE_ADDR=99

# Farm metadata
LOCATION=water-recycling
OWNER=spatialhub
WORKERS=pi

# Poll interval in seconds (5s default)
POLL_INTERVAL=5

# Django API URL (local development)
# DJANGO_URL=http://localhost:8000
# Django API URL (Cloud Run production -- use this for NASA competition)
DJANGO_URL=https://spatialhub-backend-4vovlomqfa-uc.a.run.app
