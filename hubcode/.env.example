# hub_client configuration
# Copy this file to .env and fill in the values for your deployment.

# Unique identifier for this Pi hub (set once during provisioning)
HUB_ID=pi-habitat-01

# Sensor identifier and display name
SENSOR_ID=wr-ph-real
SENSOR_NAME=pH Sensor

# I2C address of the Atlas EZO pH sensor (decimal, e.g. 99 = 0x63)
DEVICE_ADDR=99

# Physical location label for this sensor installation
LOCATION=Mars Habitat Alpha

# Owner/operator name stored with each reading
OWNER=Demo User

# Crew or team assignment label
WORKERS=Crew A

# Base URL of the Django REST API (no trailing slash)
DJANGO_URL=http://192.168.1.100:8000

# Sensor polling interval in seconds (float; default 5)
POLL_INTERVAL=5
